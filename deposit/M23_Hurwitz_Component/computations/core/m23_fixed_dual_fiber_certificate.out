A5_POLYNOMIAL (x - 1)*(x**4 + x**3 + x**2 + x + 1)
A5_DECOMPOSITION (x-1)*Phi_5(x)
INVERSION x -> x^4 = x^{-1}
INVARIANT_SUBSPACE_DIM 3
FIXED_LOCUS_GCD x - 1
FIXED_POINT x=1, t=0
EFIX (x**4 + x**3 + x**2 + x + 1)/5
EFIX_RANK 1
EFIX_TRACE 1
INVARIANT_GENERATOR y=x+x^{-1}
INVARIANT_POLYNOMIAL (y - 2)*(y**2 + y - 1)
INVARIANT_ALGEBRA Q x Q(sqrt(5))
NONFIXED_QUADRATIC_BASE Q(sqrt(5))
NONFIXED_QUADRATIC_EXTENSION Q(zeta_5)/Q(sqrt(5))
X_QUADRATIC_OVER_INVARIANTS X**2 - X*y + 1
LEDGER_N -sqrt(5)*(y - 2)*(y + 1)/5
LEDGER_N_VALUES [0, 1, -1]
LEDGER_E0 (y**2 + y - 1)/5
LEDGER_EPLUS -(y - 2)*(y + sqrt(5)*y + sqrt(5) + 3)/10
LEDGER_EMINUS (y - 2)*(-y + sqrt(5)*y - 3 + sqrt(5))/10
GALOIS_ON_LEDGER sqrt(5)->-sqrt(5): N->-N, e+<->e-, e0 fixed
BETA5_E0_FIXED True
A5_FACTOR_CORRECT True
A5_SQUAREFREE True
INVERSION_MATRIX_SQUARE_ONE True
INVARIANT_SUBSPACE_DIM True
FIXED_LOCUS_IS_X_MINUS_1 True
EFIX_IDEMPOTENT True
EFIX_MULTIPLICATION_RANK_ONE True
EFIX_MULTIPLICATION_TRACE_ONE True
INVARIANT_RELATION True
INVARIANT_GENERATOR_RANK_THREE True
INVARIANT_QUADRATIC_DISCRIMINANT_5 True
LEDGER_N_CUBIC True
LEDGER_PROJECTORS True
LEDGER_FIXED_PROJECTOR_MATCH True
LEDGER_VALUES_0_PLUS_MINUS_1 True
BETA5_FIXES_E0 True
ALL_FIXED_DUAL_CHECKS_PASS True
